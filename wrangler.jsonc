{
  // Cloudflare Worker for sorvel.agency
  //  - serves the static site from ./website
  //  - redirects www to the bare domain
  //  - collects anonymous lead events and serves the private /scoreboard dashboard (see src/index.js)
  "name": "sorvel-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // lead events live in one small SQLite-backed Durable Object (free plan, no setup)
  "durable_objects": { "bindings": [{ "name": "LEADS", "class_name": "LeadStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LeadStore"] }],
  "observability": { "enabled": true },
  // Google Analytics 4 property for the dashboard (not secret; the service account needs Viewer access)
  "vars": { "GA_PROPERTY": "563104357" },
  // hourly Search Console check for new searches (dashboard "spotted … ago")
  "triggers": { "crons": ["23 * * * *"] }
}
