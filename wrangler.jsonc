{
  // Cloudflare Workers static site: serves the ./website folder.
  // src/index.js runs first only to redirect www to the bare domain.
  "name": "sorvel-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
