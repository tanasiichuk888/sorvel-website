{
  // Cloudflare Worker for sorvel.agency
  //  - serves the static site from ./website
  //  - redirects www to the bare domain
  //  - collects anonymous lead events and serves the private /scoreboard dashboard (see src/index.js)
  "name": "sorvel-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "sorvel_events" }],
  "observability": { "enabled": true }
}
